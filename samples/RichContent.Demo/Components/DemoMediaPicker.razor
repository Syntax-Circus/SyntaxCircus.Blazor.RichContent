@namespace RichContent.Demo
@inherits SyntaxCircus.Blazor.RichContent.Editing.MediaPickerBase
@using SyntaxCircus.RichContent

<select value="@(Value?.Id ?? "")" @onchange="Changed" disabled="@Disabled" aria-label="Choose image">
    <option value="">(none)</option>
    <option value="lighthouse">Lighthouse</option>
    <option value="orchard">Orchard</option>
    <option value="workshop">Workshop</option>
</select>

@code {
    private Task Changed(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(string.IsNullOrEmpty(e.Value?.ToString()) ? null : new MediaRef(e.Value!.ToString()!));
}
