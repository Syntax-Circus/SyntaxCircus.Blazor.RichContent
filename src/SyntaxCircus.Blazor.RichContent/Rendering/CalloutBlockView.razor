<aside class="callout callout--@Block.Tone.ToString().ToLowerInvariant()">
    @if (!string.IsNullOrWhiteSpace(Block.Title))
    {
        <p class="callout__title">@Block.Title</p>
    }
    <RichTextView Nodes="Block.Nodes" HeadingIds="HeadingIds" />
</aside>

@code {
    [Parameter, EditorRequired] public CalloutBlock Block { get; set; } = default!;

    [Parameter] public IReadOnlyDictionary<RichTextNode, string>? HeadingIds { get; set; }
}
