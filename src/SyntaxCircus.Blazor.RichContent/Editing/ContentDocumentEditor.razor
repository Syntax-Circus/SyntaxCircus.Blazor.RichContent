@using SyntaxCircus.Blazor.RichContent.Editing.Writing
@if (Document is not null)
{
<div class="doc-editor" role="group" aria-label="@Label" data-rt-editor="@(Mode == RichContentEditorMode.Write)">
<CascadingValue Value="_session" IsFixed="true">
    @if (Mode == RichContentEditorMode.Write)
    {
        <WritingToolbar Disabled="Disabled" />
    }
    @if (!HasMediaPicker)
    {
        <p class="hint">No media picker is configured, so images and galleries cannot be added.</p>
    }
    @foreach (var error in DocumentErrors)
    {
        <p class="error" role="alert">@error.Message</p>
    }
    @Menu(0, true, inserted => Update(ContentDocumentOperations.Add(Latest, 0, inserted)))
    @for (var i = 0; i < Blocks.Length; i++)
    {
        var index = i;
        var block = Blocks[index];
        <section class="block" @key="KeyFor(block, index)" data-block-id="@block.Id" data-block-kind="@KindOf(block)">
            <header>
                <strong>@TitleOf(block)</strong>
                <div class="actions">
                    <button type="button" disabled="@(Disabled || index == 0)" @onclick="() => Update(ContentDocumentOperations.Move(Latest, index, -1))">Move up</button>
                    <button type="button" disabled="@(Disabled || index == Blocks.Length - 1)" @onclick="() => Update(ContentDocumentOperations.Move(Latest, index, 1))">Move down</button>
                    <button type="button" disabled="@Disabled" @onclick="() => Update(ContentDocumentOperations.Remove(Latest, index))">Remove</button>
                </div>
            </header>
            @switch (block)
            {
                case RichTextBlock rich when Mode == RichContentEditorMode.Write:
                    <WritingBlock Nodes="rich.Nodes" NodesChanged="nodes => WriteNodes(index, rich.Id, nodes)" Disabled="Disabled" Label="Text block" />
                    break;
                case RichTextBlock rich:
                    <RichTextEditor Nodes="rich.Nodes" NodesChanged="nodes => Replace(index, rich with { Nodes = nodes })" Disabled="Disabled" Label="Text block" MaxDepth="MaxDepth"
                                    BetweenNodes="nodeIndex => Menu(nodeIndex, false, inserted => Update(ContentDocumentOperations.SplitRichText(Latest, index, nodeIndex, inserted)))" />
                    break;
                case GalleryBlock gallery:
                    <GalleryBlockEditor Block="gallery" BlockChanged="updated => Replace(index, updated)" Disabled="Disabled" />
                    break;
                case CalloutBlock callout:
                    <CalloutBlockEditor Block="callout" BlockChanged="updated => Replace(index, updated)" Disabled="Disabled" MaxDepth="MaxDepth" />
                    break;
                case CtaBlock cta:
                    <CtaBlockEditor Block="cta" BlockChanged="updated => Replace(index, updated)" Disabled="Disabled" />
                    break;
                case ExtensionBlock extension when Registry.TryGet(extension.Type, out var registration) && registration.Editor is { } editor:
                    <ErrorBoundary>
                        <ChildContent>
                            <DynamicComponent Type="editor" Parameters="ExtensionParameters(extension, index)" />
                        </ChildContent>
                        <ErrorContent><p class="preserved">This block's editor failed to load; the block is kept unchanged.</p></ErrorContent>
                    </ErrorBoundary>
                    break;
                case ExtensionBlock extension when Registry.TryGet(extension.Type, out _):
                    <p class="preserved">This block has no editor (kept as-is).</p>
                    <pre>@extension.Data.GetRawText()</pre>
                    break;
                default:
                    <p class="preserved">This is an unsupported block (kept as-is). It is preserved when you save.</p>
                    break;
            }
            @if (ErrorsFor(index) is { Count: > 0 } errors)
            {
                <ul class="errors" role="alert">
                    @foreach (var error in errors)
                    {
                        <li>@error.Message</li>
                    }
                </ul>
            }
        </section>
        @Menu(index + 1, true, inserted => Update(ContentDocumentOperations.Add(Latest, index + 1, inserted)))
    }
</CascadingValue>
</div>
}

@code {
    private RenderFragment Menu(int position, bool includeText, Func<ContentBlock, Task> insert) =>
        @<details class="insert-menu" data-position="@position">
            <summary>Insert block</summary>
            <div class="actions">
                @foreach (var choice in Choices.Where(c => includeText || !c.IsText))
                {
                    var blocked = choice.NeedsMedia && !HasMediaPicker;
                    <button type="button" disabled="@(Disabled || blocked)" title="@(blocked ? "No media picker is configured." : null)" @onclick="() => insert(choice.Create())">@choice.Label</button>
                }
            </div>
        </details>;
}
