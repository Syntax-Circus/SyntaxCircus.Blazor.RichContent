@using SyntaxCircus.Blazor.RichContent.Editing.Writing
<div class="fields">
    <label>Heading<input type="text" value="@Current.Heading" maxlength="@FieldLength" @oninput="e => Update(Current with { Heading = Text(e) })" disabled="@Disabled" /></label>
    <label>Body<textarea value="@Current.Body" maxlength="@FieldLength" @oninput="e => Update(Current with { Body = Optional(e) })" disabled="@Disabled" rows="3"></textarea></label>
    <label>Button label<input type="text" value="@Current.Label" maxlength="@FieldLength" @oninput="e => Update(Current with { Label = Text(e) })" disabled="@Disabled" /></label>
    <label>Button link<input type="text" value="@Current.Url" maxlength="@FieldLength" @oninput="e => Update(Current with { Url = Text(e) })" disabled="@Disabled" /></label>
</div>

@code {
    [Parameter, EditorRequired] public CtaBlock Block { get; set; } = default!;

    [Parameter] public EventCallback<CtaBlock> BlockChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    // In Write mode, an edit can arrive before the block with the last one has been passed back down, so each one
    // must build on the one before.
    private CtaBlock? _parameter;
    private CtaBlock? _latest;

    [CascadingParameter] private WritingSession? Session { get; set; }

    private CtaBlock Current => Session?.Writing == true && _latest is not null ? _latest : Block;

    protected override void OnParametersSet()
    {
        // The same object as last time is no news. Another is the host's, and wins.
        // In the block view the parameter is the truth: an edit the host refused must not come back in Write mode.
        if (!ReferenceEquals(Block, _parameter) || Session?.Writing != true)
        {
            _parameter = _latest = Block;
        }
    }

    private int? FieldLength => Session?.Writing == true ? WritingSession.FieldCharacters : null;

    private Task Update(CtaBlock block)
    {
        if (Session?.Writing == true)
        {
            _latest = block;
        }

        return BlockChanged.InvokeAsync(block);
    }

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    private static string? Optional(ChangeEventArgs e) => string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
}
