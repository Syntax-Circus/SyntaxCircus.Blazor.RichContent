@using SyntaxCircus.Blazor.RichContent.Editing.Surfaces
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<WritingToolbar> Logger
@inject RichContentEditorOptions Options

@* The script runs the buttons that carry data-rt-command or data-rt-insert, in the click itself, so that what they
   change is on its way before anything clicked afterwards. Only the link goes through here, to have its address
   checked. *@
<div @ref="_area" class="rt-toolbar-area" data-rt-toolbar-area data-rt-drawn="@_drawn">
  <div class="rt-toolbar" role="toolbar" aria-label="Formatting" data-rt-toolbar>
    @Toggle("bold", "Bold", "B", "Control+B Meta+B", CanFormat, Selection?.Bold)
    @Toggle("italic", "Italic", "I", "Control+I Meta+I", CanFormat, Selection?.Italic)
    @Toggle("code", "Inline code", "<>", "Control+E Meta+E", CanFormat, Selection?.Code)
    <button type="button" aria-keyshortcuts="Control+K Meta+K" disabled="@(!CanFormat)"
            aria-pressed="@Pressed(Selection?.LinkUrl is not null)" @onclick="OpenLink">Link</button>
    <select aria-label="Text style" data-rt-command="style" disabled="@(!CanStyle)" value="@(Selection?.Style ?? "p")">
      <option value="p">Paragraph</option>
      <option value="h2">Heading</option>
      <option value="h3">Subheading</option>
      <option value="h4">Small heading</option>
    </select>
    @Toggle("bullets", "Bulleted list", "• List", null, CanList, Selection?.List == "bullets")
    @Toggle("numbers", "Numbered list", "1. List", null, CanList, Selection?.List == "numbers")
    @Toggle("quote", "Quote", "Quote", null, CanQuote, Selection?.Quote)
    <button type="button" aria-haspopup="true" aria-expanded="@(InsertOpen ? "true" : "false")" disabled="@(!CanInsert)" @onclick="ToggleInsert">Insert</button>
    @if (InsertOpen)
    {
      var choices = Place!.Choices;
      <div class="rt-insert-menu" role="group" aria-label="Insert">
        @for (var i = 0; i < choices.Count; i++)
        {
          var blocked = choices[i].NeedsMedia && Options.MediaPicker is null;
          <button type="button" data-rt-insert="@i" disabled="@blocked" title="@(blocked ? "No media picker is configured." : null)">@choices[i].Label</button>
        }
      </div>
    }
  </div>
  @if (_stalled)
  {
    <p class="rt-toolbar-stalled" role="status">@WriteModeMessages.ToolsStalled</p>
  }
  @if (_linkTarget is not null)
  {
    <div @key="_linkOpening" class="rt-link-box" role="group" aria-label="Link">
      <label>Link address
        <input @ref="_linkInput" data-rt-link-input type="text" inputmode="url" autocomplete="off" maxlength="@WritingSession.FieldCharacters" @bind="_address" @bind:event="oninput" @onkeydown="LinkKeyAsync" />
      </label>
      @* Once the address as typed has been accepted, the script can apply it in the click itself. *@
      <button type="button" data-rt-link-apply data-rt-checked="@(CheckedAddress is null ? null : _address)" data-rt-address="@CheckedAddress" @onclick="ApplyLinkAsync">Apply link</button>
      <button type="button" data-rt-link-remove @onclick="() => CloseLinkAsync(string.Empty)">Remove link</button>
      <button type="button" @onclick="() => CloseLinkAsync(null)">Cancel</button>
      @if (_truncated)
      {
        <p class="error" role="alert">@WriteModeMessages.LinkTooLong</p>
      }
      else if (_refused)
      {
        <p class="error" role="alert">This address cannot be linked. Use an https:, mailto: or tel: address, or a path on this site that starts with a single /. Spaces, quotes, backslashes and user names are not allowed.</p>
      }
    </div>
  }
</div>

@code {
  private ElementReference _area;
  private ElementReference _linkInput;
  private IJSObjectReference? _module;
  private WritingSession? _subscribed;
  private RichTextSurface? _linkTarget;
  private string _address = "";
  private bool _refused;
  // True when the box was opened on an address of which it holds only the start. Settled then, with what it holds.
  private bool _truncated;
  private bool _focusLinkInput;
  private int _linkOpening;
  // The surface the Insert menu was opened for.
  private RichTextSurface? _insertTarget;
  private bool _disposed;
  private readonly CancellationTokenSource _disposal = new();
  private bool _attached;
  // True while the script has not taken the toolbar for longer than a round trip takes.
  private bool _stalled;
  private DotNetObjectReference<WritingToolbar>? _self;
  // Names this toolbar to the script, which cannot be given its element once that has gone.
  private readonly string _key = Guid.NewGuid().ToString("n");
  // The latest number the script asked to see, which tells it that what came before has been drawn. See freeze.js.
  private long _drawn;

  [CascadingParameter] private WritingSession? Session { get; set; }

  [Parameter] public bool Disabled { get; set; }

  private SurfaceSelection? Selection => Session?.Selection;

  private bool CanFormat => !Disabled && Selection is not null;

  private bool IsProse => Session?.Surface?.Profile == RichTextSurfaceProfile.Prose;

  private bool CanList => CanFormat && IsProse;

  // The model has no heading inside a list item or a quote, and no quote inside a list item.
  private bool CanStyle => CanList && Selection is { InListItem: false, Quote: false };

  private bool CanQuote => CanList && Selection is { InListItem: false };

  private IInsertPlace? Place => Session?.Surface?.InsertPlace;

  // Nothing can be inserted into a table cell, whose surface has no place for it.
  private bool CanInsert => CanFormat && IsProse && Place is { Choices.Count: > 0 };

  private bool InsertOpen => CanInsert && ReferenceEquals(_insertTarget, Session?.Surface);

  private void ToggleInsert() => _insertTarget = InsertOpen ? null : Session?.Surface;

  private static string Pressed(bool? on) => on == true ? "true" : "false";

  private RenderFragment Toggle(string command, string label, string text, string? shortcuts, bool enabled, bool? on) =>
    @<button type="button" data-rt-command="@command" aria-label="@label" aria-keyshortcuts="@shortcuts" disabled="@(!enabled)" aria-pressed="@Pressed(on)">@text</button>;

  protected override void OnInitialized()
  {
    _subscribed = Session;
    if (_subscribed is not null)
    {
      _subscribed.Changed += SessionChanged;
      _subscribed.LinkRequested += LinkRequested;
      _subscribed.LinkApplied += LinkApplied;
    }
  }

  protected override void OnParametersSet()
  {
    if (Disabled)
    {
      _linkTarget = null;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      // Not waited for here: it goes on for as long as it takes.
      _ = AttachUntilDoneAsync();
    }

    // This can be an earlier render completing, with the box not drawn yet: Blazor holds renders back while too many
    // are unacknowledged. The input has a reference only once it has been drawn.
    if (_focusLinkInput && _linkTarget is not null && _linkInput.Id is not null)
    {
      _focusLinkInput = false;
      await InteropAsync(async () => await _linkInput.FocusAsync());
    }
  }

  // Until the script has the toolbar, nothing in the editor can be typed into. So an attempt that is lost, cancelled
  // or never answered is made again, and the author is told while it goes on.
  private async Task AttachUntilDoneAsync()
  {
    try
    {
      var delay = Options.ScriptRetryDelay;
      var longest = delay * 8;
      while (!_disposed && !_attached)
      {
        var attempt = AttachAsync();
        var pause = Task.Delay(delay, _disposal.Token);
        if (await Task.WhenAny(attempt, pause) == attempt && await attempt)
        {
          break;
        }

        await pause;
        if (!_disposed && !_attached)
        {
          _stalled = true;
          StateHasChanged();
          delay = delay * 2 < longest ? delay * 2 : longest;
        }
      }

      if (_stalled && !_disposed)
      {
        _stalled = false;
        StateHasChanged();
      }
    }
    catch (OperationCanceledException)
    {
    }
    catch (Exception exception)
    {
      await DispatchExceptionAsync(exception);
    }
  }

  // True when there is nothing more to try.
  private async Task<bool> AttachAsync()
  {
    try
    {
      if (_module is null)
      {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", RichTextSurface.ModulePath);
        if (_disposed)
        {
          await module.DisposeAsync();
          return true;
        }

        _module ??= module;
      }

      _self ??= DotNetObjectReference.Create(this);
      await _module.InvokeVoidAsync("attachToolbar", _area, _self, _key);
      _attached = true;
      return true;
    }
    catch (JSDisconnectedException)
    {
    }
    catch (OperationCanceledException exception)
    {
      Logger.LogDebug(exception, "A call to the writing toolbar's script was cancelled.");
    }
    catch (ObjectDisposedException) when (_disposed)
    {
      return true;
    }
    catch (JSException exception)
    {
      Logger.LogError(exception, "The writing toolbar's script could not be loaded or run.");
      if (!_disposed)
      {
        Session?.ReportScriptFailure();
      }

      return true;
    }

    return false;
  }

  /// <summary>
  /// Draws <paramref name="number"/> into the toolbar, so that the script can tell that the page shows everything
  /// done before this was asked. For the script only.
  /// </summary>
  [JSInvokable]
  public Task Redraw(long number)
  {
    if (!_disposed)
    {
      // In the same render queue as whatever came before, and so never drawn ahead of it.
      _drawn = number;
      StateHasChanged();
    }

    return Task.CompletedTask;
  }

  private void SessionChanged()
  {
    // The box belongs to one surface. It closes if the cursor has gone to another, or that one has gone.
    if (_linkTarget is not null && !ReferenceEquals(_linkTarget, Session?.Surface))
    {
      _linkTarget = null;
    }

    // The menu does not reopen by itself if the cursor comes back.
    if (_insertTarget is not null && !ReferenceEquals(_insertTarget, Session?.Surface))
    {
      _insertTarget = null;
    }

    StateHasChanged();
  }

  // The script has applied the link itself. Only the box is left to close.
  private void LinkApplied(RichTextSurface surface)
  {
    if (ReferenceEquals(surface, _linkTarget))
    {
      _linkTarget = null;
      StateHasChanged();
    }
  }

  private void LinkRequested()
  {
    OpenLink();
    StateHasChanged();
  }

  private void OpenLink()
  {
    if (!CanFormat)
    {
      return;
    }

    if (_linkTarget is null)
    {
      // A new box each time it opens, so that drawing it gives a new reference to its input.
      _linkOpening++;
      _linkInput = default;
    }

    _linkTarget = Session!.Surface;
    _address = Selection!.LinkUrl ?? "";
    _truncated = Selection.LinkUrlTruncated;
    _refused = false;
    _focusLinkInput = true;
  }

  private Task LinkKeyAsync(KeyboardEventArgs key) => key.Key switch
  {
    "Enter" => ApplyLinkAsync(),
    "Escape" => CloseLinkAsync(null),
    _ => Task.CompletedTask,
  };

  // What the typed address would be linked as, or null if it may not be. An empty address removes the link.
  private string? CheckedAddress
  {
    get
    {
      var address = _address.Trim();
      // Where the box began with only the start of an address, nothing in it can be told from that start, changed or
      // not, so only removal is left.
      return address.Length == 0 || (!_truncated && RichContentUrl.IsSafe(address, Session!.Limits.UrlCharacters))
        ? address
        : null;
    }
  }

  private Task ApplyLinkAsync()
  {
    if (CheckedAddress is not { } address)
    {
      _refused = true;
      return Task.CompletedTask;
    }

    return CloseLinkAsync(address);
  }

  // With an address, runs the link command. With null, only goes back to the text.
  private async Task CloseLinkAsync(string? address)
  {
    var target = _linkTarget;
    _linkTarget = null;
    if (target is null)
    {
      return;
    }

    if (address is null)
    {
      await target.RestoreAsync();
    }
    else
    {
      await target.CommandAsync("link", address);
    }
  }

  // A lost connection or a script that failed must not end the circuit.
  private async Task InteropAsync(Func<Task> call)
  {
    try
    {
      await call();
    }
    catch (JSDisconnectedException)
    {
    }
    catch (OperationCanceledException exception)
    {
      Logger.LogDebug(exception, "A call to the writing toolbar's script was cancelled.");
    }
    catch (JSException exception)
    {
      Logger.LogError(exception, "A call to the writing toolbar's script failed.");
    }
  }

  public async ValueTask DisposeAsync()
  {
    _disposed = true;
    _disposal.Cancel();
    _disposal.Dispose();
    if (_subscribed is not null)
    {
      _subscribed.Changed -= SessionChanged;
      _subscribed.LinkRequested -= LinkRequested;
      _subscribed.LinkApplied -= LinkApplied;
    }

    if (_module is { } module)
    {
      // The script goes on asking this component to redraw until it is told to stop. Messages arrive in order, so once
      // this has returned nothing more will be asked, and the reference below can go.
      await InteropAsync(() => module.InvokeVoidAsync("detachToolbar", _key).AsTask());
      await InteropAsync(async () => await module.DisposeAsync());
    }

    _self?.Dispose();
  }
}
