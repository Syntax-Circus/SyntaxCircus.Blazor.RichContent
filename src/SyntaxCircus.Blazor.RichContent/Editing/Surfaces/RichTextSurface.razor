@inherits ScriptEditorBase

@if (LoadFailed)
{
  <p class="rt-surface-failed" role="alert">The writing surface could not be loaded.</p>
}
else
{
  @* The script owns what is inside this element, so nothing is ever rendered into it. *@
  <div @ref="Element" class="rt-surface" data-rt-surface="@(Profile == RichTextSurfaceProfile.Inline ? "inline" : "prose")"
       role="textbox" aria-multiline="true" aria-label="@Label"></div>
}
