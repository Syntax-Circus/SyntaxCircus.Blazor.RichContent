@using SyntaxCircus.Blazor.RichContent.Editing.Writing
<div class="fields">
    <label>Tone
        <select value="@Current.Tone.ToString()" @onchange="ToneChanged" disabled="@Disabled">
            @foreach (var tone in Enum.GetValues<CalloutTone>())
            {
                <option value="@tone.ToString()">@tone</option>
            }
        </select>
    </label>
    <label>Title<input type="text" value="@Current.Title" maxlength="@(Writing ? WritingSession.FieldCharacters : null)" @oninput="TitleChanged" disabled="@Disabled" /></label>
    @if (Writing)
    {
        <WritingBlock Nodes="Current.Nodes" NodesChanged="NodesChanged" Disabled="Disabled" Label="Callout text" MaxDepth="MaxDepth"
                      InsertChoices="InsertChoice.ForNodes(MaxDepth)" />
    }
    else
    {
        <RichTextEditor Nodes="Block.Nodes" NodesChanged="NodesChanged" Disabled="Disabled" Label="Callout text" MaxDepth="MaxDepth" />
    }
</div>

@code {
    // In Write mode, edits can arrive before the new block has been passed back down, so each one must build on the
    // one before.
    private CalloutBlock? _parameter;
    private CalloutBlock? _latest;

    [CascadingParameter] private WritingSession? Session { get; set; }

    [Parameter, EditorRequired] public CalloutBlock Block { get; set; } = default!;

    [Parameter] public EventCallback<CalloutBlock> BlockChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public int MaxDepth { get; set; } = RichContentLimits.Default.Depth;

    private bool Writing => Session?.Writing == true;

    private CalloutBlock Current => Writing && _latest is not null ? _latest : Block;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Block, _parameter))
        {
            _parameter = _latest = Block;
        }
    }

    private Task Update(CalloutBlock block)
    {
        _latest = block;
        return BlockChanged.InvokeAsync(block);
    }

    private Task ToneChanged(ChangeEventArgs e) =>
        Enum.TryParse<CalloutTone>(e.Value?.ToString(), out var tone) ? Update(Current with { Tone = tone }) : Task.CompletedTask;

    private Task TitleChanged(ChangeEventArgs e) =>
        Update(Current with { Title = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString() });

    private Task NodesChanged(System.Collections.Immutable.ImmutableArray<RichTextNode> nodes) =>
        Update(Current with { Nodes = nodes });
}
